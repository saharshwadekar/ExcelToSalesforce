<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui">
    <ribbon>
<tabs>
<tab id="customTab_Salesforce" label="Salesforce Tools">
<group id="customGroup_Login" label="Session">
<button id="customButton_Login" label="Login / Logout"
onAction="Salesforce_Login"
imageMso="OmsConnectToOutlook"
size="large" />
</group>
<group id="customGroup_Quotes" label="Quotes">
<button id="customButton_CreateQuote" label="Create Quote"
onAction="Salesforce_CreateQuoteFromOpportunity"
imageMso="ObjectsPageBreakInsert"
size="large" />
</group>
</tab>
</tabs>
</ribbon>
</customUI>
